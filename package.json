{
  "name": "@smitfire/cuga",
  "version": "0.1.0",
  "description": "DSH plugin & MCP server for IBM CUGA-inspired IntentGuard, ToolGuard HITL, adaptive reasoning, and trajectory reuse",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smitfire/cuga.git"
  },
  "main": "./dist/dsh/index.js",
  "types": "./dist/dsh/index.d.ts",
  "bin": {
    "ns-cuga": "./dist/mcp/server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/dsh/index.d.ts",
      "default": "./dist/dsh/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/server.d.ts",
      "default": "./dist/mcp/server.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0-0",
    "node": ">=24.0.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/mcp/server.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test test/*.test.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.3 <0.3.0-0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.2-rc.3 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.3 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@deepseek-ai/schemastery": "3.19.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
